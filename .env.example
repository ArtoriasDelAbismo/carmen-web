VITE_BACKEND_URL=http://localhost:3000

# Carmen device token (90 days) from cuidarte-ia-backend's POST /api/carmen/device-token,
# called once with a familiar's login JWT — ties this device to the familiar's patient.
# A familiar or caregiver login JWT (24h) also works as a stopgap.
VITE_DEV_JWT=

# "openai" (default/fallback) or "elevenlabs" (accent-quality experiment)
VITE_VOICE_PROVIDER=openai

# "classic" (default): Carmen as always, no patient data.
# "data": Carmen with the patient's profile and health-data tools (MCP).
VITE_CARMEN_MODE=classic

# Only for VITE_CARMEN_MODE=data. Not needed with a device token or a familiar with one
# patient. Otherwise: which patient Carmen talks to (linked to the familiar / assigned to
# the caregiver; empty with a caregiver → the backend's CARMEN_DEFAULT_PATIENT_ID).
VITE_PATIENT_ID=
