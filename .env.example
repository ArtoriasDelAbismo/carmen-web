VITE_BACKEND_URL=http://localhost:3000

# Temporary: paste a JWT obtained from cuidarte-ia-backend's existing /api/auth login
# flow here so the dev build can call the protected /api/realtime/session route.
# Replace this with a real login screen before shipping.
VITE_DEV_JWT=

# "openai" (default/fallback) or "elevenlabs" (accent-quality experiment)
VITE_VOICE_PROVIDER=openai

# Temporary: which patient Carmen talks to. The caregiver behind VITE_DEV_JWT must be
# assigned to it. Empty → the backend's CARMEN_DEFAULT_PATIENT_ID.
VITE_PATIENT_ID=

# "carmen-test" uses the test copy of Carmen's ElevenLabs agent; empty → production agent.
VITE_ELEVENLABS_ASSISTANT=
